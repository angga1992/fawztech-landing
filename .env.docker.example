# Variabel untuk docker-compose.yml (bukan .env.local yang dipakai `npm run dev`).
# Di server disalin sebagai .env oleh scripts/deploy.sh dari .env.deploy (gitignored).
TAG=latest
SITE_URL=https://fawztech.id
# Host untuk nginx + certbot (scripts/deploy.sh) dan port di 127.0.0.1 yang diproksi nginx
LANDING_HOSTS="fawztech.id www.fawztech.id"
ACME_EMAIL=contact@fawztech.id
LANDING_PORT=3000
LEADS_API_URL=http://internal:3100/api/public/leads
# Sama dengan LEADS_API_TOKEN di fawz-internal/.env.deploy
LEADS_API_TOKEN=

# Dibakar saat build
NEXT_PUBLIC_CONTACT_EMAIL=contact@fawztech.id
NEXT_PUBLIC_CONTACT_PHONE="+62 821-1238-7670"
NEXT_PUBLIC_WA_NUMBER="+62 821-1238-7670"
NEXT_PUBLIC_INSTAGRAM=
NEXT_PUBLIC_LINKEDIN=
NEXT_PUBLIC_REPLY_DAYS=2
# Kosong sampai klien mengizinkan: arfindo-bersinar,menya-sakura,museum-nasional,kkara atau all
NEXT_PUBLIC_PORTFOLIO_CLIENTS=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Cloudflare Turnstile produksi; kosong = hanya honeypot + rate limit
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
GEO_COUNTRY_HEADER=
