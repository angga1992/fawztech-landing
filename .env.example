# Salin ke .env.local dan isi. Nilai yang kosong memakai placeholder dari naskah.

# URL publik situs (tanpa garis miring di akhir). Dipakai untuk canonical, OG, sitemap, JSON-LD.
SITE_URL=https://domainanda.id

# Kontak yang tampil di footer, JSON-LD, dan halaman privasi.
NEXT_PUBLIC_CONTACT_EMAIL=
# Nomor telepon tampilan (opsional; bila kosong memakai nomor WhatsApp).
NEXT_PUBLIC_CONTACT_PHONE=
# Nomor WhatsApp untuk tombol "Chat lewat WhatsApp"; format 08…, +62…, atau 62…. Tombol disembunyikan bila kosong.
NEXT_PUBLIC_WA_NUMBER=
# Handle Instagram, contoh @fawztech
NEXT_PUBLIC_INSTAGRAM=
# URL profil LinkedIn perusahaan
NEXT_PUBLIC_LINKEDIN=
# Janji waktu balas (angka hari kerja) untuk pesan sukses form, contoh 2
NEXT_PUBLIC_REPLY_DAYS=

# Portofolio: slug klien yang SUDAH mengizinkan nama dan tampilannya tayang di web publik, dipisah koma,
# atau "all". Pilihan: arfindo-bersinar, menya-sakura, museum-nasional, kkara. Kosong = seksi portofolio
# (dan tautan navnya) disembunyikan. Studi kasus Arfindo ikut tayang bila arfindo-bersinar diizinkan.
NEXT_PUBLIC_PORTFOLIO_CLIENTS=

# Deteksi negara untuk bahasa (id untuk Indonesia, en untuk negara lain). Secara bawaan membaca
# x-vercel-ip-country, cf-ipcountry, cloudfront-viewer-country, lalu x-country-code. Isi nama header
# kustom bila proxy Anda (mis. Nginx geoip2) mengirim kode negara lewat header lain.
GEO_COUNTRY_HEADER=

# Analitik tanpa cookie (Plausible). Kosongkan untuk menonaktifkan.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Cloudflare Turnstile. Kosongkan keduanya untuk melewati verifikasi (hanya untuk dev/staging).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Tujuan prospek. Urutan: LEADS_API_URL (sistem internal) → LEADS_WEBHOOK_URL (cadangan) → log (dev) / 503 (prod).
# Endpoint sistem internal sesuai internal-app.md, contoh https://internal.domainanda.id/api/public/leads
LEADS_API_URL=
# Token Bearer bila sistem internal memintanya (opsional)
LEADS_API_TOKEN=
# Webhook JSON generik (n8n, Make, Apps Script) yang meneruskan ke email atau spreadsheet tim
LEADS_WEBHOOK_URL=
# Origin yang diizinkan memanggil /api/leads selain same-origin (opsional, contoh https://domainanda.id)
LEADS_ALLOWED_ORIGIN=
